# App
APP_NAME=Raaste API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/raaste

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI / AI providers
OPENAI_API_KEY=sk-...

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=...
